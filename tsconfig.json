{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"baseUrl": "./",
		"paths": {
			"@components/*": ["app/components/*"],
			"@constants/*": ["app/constants/*"],
			"@hooks/*": ["app/hooks/*"],
			"@services/*": ["app/services/*"],
			"@contexts/*": ["app/contexts/*"],
			"@utils/*": ["app/utils/*"],
			"@feature/*": ["app/feature/*"],
			"@navigation/*": ["app/navigation/*"],
			"@assets/*": ["assets/*"]
		}
	},
	"include": [
		"**/*.ts",
		"**/*.tsx",
		".expo/types/**/*.ts",
		"expo-env.d.ts",
		"nativewind-env.d.ts"
	]
}
